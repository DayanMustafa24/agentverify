@'
# Any OpenAI-compatible endpoint works (OpenAI, Ollama, vLLM, Together, Groq ...)
# Add your actual API key to your local .env file
OPENAI_API_KEY=

# Leave empty for OpenAI. For a local Ollama server use http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Vision-capable model name served by the endpoint
AV_MODEL=gpt-4o-mini

AV_TEMPERATURE=0
'@ | Set-Content -Path .env.example